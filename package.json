{
  "name": "hf-observatory",
  "private": true,
  "type": "module",
  "description": "Static site exploring the Hugging Face model ecosystem (data: radar-huggingface-dataset, CC-BY-4.0)",
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory web",
    "test": "node --test tests/advisor-engine.test.mjs tests/advisor-calibration.test.mjs tests/advisor-fuzz.test.mjs",
    "test:e2e": "node tests/smoke.mjs",
    "screenshots": "node tests/smoke.mjs --screenshots docs/screenshots"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "yaml": "2.8.1"
  }
}
